+_BRACE_GROUP = re.compile(r"\{([^{}]*,[^{}]*)\}")
+_MAX_BRACE_WORD = 8192  # characters in one word that holds a brace list
+_MAX_BRACE_RESULTS = 1024  # words one brace list may expand to
