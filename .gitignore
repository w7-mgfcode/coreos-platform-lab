# Session handoffs and local agent state: never published
HANDOFF.md
.handoffs/
.claude/settings.local.json
.claude/worktrees/

# Rendered Ignition is a build artifact and may embed secret material
*.ign

# Secret source files live outside git; only example files are tracked
secrets/
.env
.env.*
!.env.example
*.pem
*.key

# Python caches from the diagram generators
__pycache__/
*.pyc

# Editors and operating systems
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Agent tooling that is not specific to this project: generic and third-party
# skills stay available locally but are not published with the repository
.claude/skills/analyzing-ai-repos/
.claude/skills/git-history-manager/
.claude/skills/issue-to-subtasks/
.claude/skills/managing-agent-memory/
.claude/skills/managing-llms-txt/
.claude/skills/preparing-skill-briefs/
.claude/skills/processing-coderabbit-reviews/
.claude/skills/prompt-architect/
.claude/skills/skill-creator/
.claude/skills/writing-session-handoffs/
.agents/skills/writing-session-handoffs/
.claude/commands/prompts/ai-engineer-doc-architect-prompt.md

# Proxmox lab tooling. lab-agent/ is tracked (decision D-57; it was excluded from the initial
# publication, D-49) except the local-only files below. Private settings, state, logs and
# reports of a working copy never enter the repository.
/lab-agent/env
/lab-agent/env.*
!/lab-agent/env.example
/lab-agent/state/
/lab-agent/logs/
/lab-agent/reports/
/lab-agent/*.log
# Dated history, not current: kept outside the repository.
/lab-agent/docs/l1-closeout.md
# Proposed patches: only the four that the unit tests apply are tracked.
/lab-agent/docs/proposed-patches/*
!/lab-agent/docs/proposed-patches/pve-guard-fail-closed.patch
!/lab-agent/docs/proposed-patches/pve-guard-absolute-path-ssh.patch
!/lab-agent/docs/proposed-patches/pve-guard-ssh-alias-form.patch
!/lab-agent/docs/proposed-patches/l2-source-address-pve-lab-agent.patch
# Four synthetic TLS test fixtures (test-only, they protect nothing; see lab-agent/tests/README.md):
# exceptions to the global *.pem and *.key rules, and nothing broader.
!/lab-agent/tests/tls-fixture-ca-nokeyusage.pem
!/lab-agent/tests/tls-fixture-ca-unrelated.pem
!/lab-agent/tests/tls-fixture-server.pem
!/lab-agent/tests/tls-fixture-server.key
# Parts of the lab workstream that stay local (not covered by D-57): the MCP server entry, the
# active guard hook and agent definition, the design plan and the proposed governance changes.
/.mcp.json
/.claude/agents/pve-lab.md
/.claude/hooks/pve-guard.py
/.agents/plans/proxmox-admin-agent-plan.md
/.agents/plans/proxmox-admin-agent-governance.diff

# Local-only agent instructions for this checkout
/CLAUDE.local.md
